#!/usr/bin/env python3
"""q — task queue between the orchestrator and the herdr agents (local SQLite).

Orchestrator:
  q add <agent> [text | -]          enqueue (text as argument, or stdin with "-") and try to dispatch right away
  q tick                            dispatch the next task of every free agent (idle/done in herdr)
  q wait [id ...] [--timeout S]     wait for the tasks (default: all open ones) to be answered
  q list [--all | --status S]       list tasks (default: those not validated/cancelled)
  q show <id>                       show prompt, answer and validation
  q validate <id> [note]            accept the answer
  q reject <id> [note] [--retry]    reject; with --retry, re-enqueue the prompt + note for the same agent
  q cancel <id>                     cancel a task that has not been answered yet

Agents:
  q answer <id> [text | -]          store the final answer (stdin when "-" or no text);
                                    can be repeated to fix it until the task is validated
  q fail <id> [text | -]            store that the task could not be completed, and why

Database: $Q_DB (the shim generated by herdr-db-setup in <root>/.herdr-db/q sets it) or ~/.local/share/herdr-db/queue.db.
States: pending -> sent -> answered|failed -> validated|rejected (or cancelled).
"""
import json
import os
import re
import sqlite3
import subprocess
import sys
import time

DB = os.path.expanduser(os.environ.get("Q_DB") or "~/.local/share/herdr-db/queue.db")
# path the agents must call: the workspace shim (which sets Q_DB) or this file itself
Q = os.environ.get("Q_SELF") or os.path.realpath(__file__)
OPEN = ("pending", "sent")
DONE = ("answered", "failed")
FREE = ("idle", "done")

SCHEMA = """
CREATE TABLE IF NOT EXISTS tasks (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  agent        TEXT NOT NULL,
  prompt       TEXT NOT NULL,
  status       TEXT NOT NULL DEFAULT 'pending'
               CHECK (status IN ('pending','sent','answered','failed','validated','rejected','cancelled')),
  response     TEXT,
  notes        TEXT,
  parent_id    INTEGER REFERENCES tasks(id),
  created_at   TEXT NOT NULL DEFAULT (datetime('now','localtime')),
  sent_at      TEXT,
  answered_at  TEXT,
  validated_at TEXT
);
CREATE INDEX IF NOT EXISTS tasks_agent_status ON tasks(agent, status);
"""

ENVELOPE = """[task #{id} from the orchestrator queue]

{prompt}

---
When you are done, store your final answer in the queue (that is the only way the orchestrator receives it).
Run exactly this, with the text written directly inside the heredoc (do not use variables such as $ANSWER):
{q} answer {id} <<'END_Q'
<full answer, in the requested format>
END_Q
If you cannot complete the task (blocker, error, missing permission or information), use `{q} fail {id}` the same way.
If you stored something wrong, run `answer` again: it replaces the answer until the task is validated.
NEVER edit, recreate or redirect output into {q}, and never touch {db} directly (sqlite3/python). If the command fails, paste the error in the chat and stop.
After storing it, reply in the chat only: stored #{id}"""


def db():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    c = sqlite3.connect(DB, timeout=30)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA busy_timeout=30000")
    c.executescript(SCHEMA)
    return c


def die(msg, code=1):
    print(f"q: {msg}", file=sys.stderr)
    sys.exit(code)


def text_arg(args):
    if not args or args == ["-"]:
        data = sys.stdin.read()
    else:
        data = " ".join(args)
    data = data.strip("\n")
    if not data.strip():
        die("empty text")
    if re.fullmatch(r"\s*\$\{?\w+\}?\s*", data):
        die(f"the text is just '{data.strip()}': an unexpanded variable. Write the answer directly inside the heredoc.")
    return data


def get(c, tid):
    r = c.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
    if not r:
        die(f"task #{tid} does not exist")
    return r


def herdr_agents():
    """name -> agent status in herdr (empty if herdr does not answer)."""
    try:
        out = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True, timeout=15).stdout
        return {a.get("name"): a["agent_status"] for a in json.loads(out)["result"]["agents"] if a.get("name")}
    except Exception:
        return {}


def tick(c, quiet=False):
    """Dispatch the oldest pending task of every agent that is free and has no task in progress."""
    agents = herdr_agents()
    sent = []
    busy = {r["agent"] for r in c.execute("SELECT DISTINCT agent FROM tasks WHERE status='sent'")}
    for r in c.execute("SELECT * FROM tasks WHERE status='pending' ORDER BY id").fetchall():
        a = r["agent"]
        if a in busy or agents.get(a) not in FREE:
            continue
        msg = ENVELOPE.format(id=r["id"], prompt=r["prompt"], q=Q, db=DB)
        p = subprocess.run(["herdr", "agent", "prompt", a, msg], capture_output=True, text=True)
        if p.returncode != 0:
            print(f"q: failed to send #{r['id']} to {a}: {p.stderr.strip() or p.stdout.strip()}", file=sys.stderr)
            continue
        c.execute("UPDATE tasks SET status='sent', sent_at=datetime('now','localtime') WHERE id=?", (r["id"],))
        c.commit()
        busy.add(a)
        sent.append(r["id"])
        if not quiet:
            print(f"sent #{r['id']} -> {a}")
    return sent


def short(s, n=70):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[: n - 1] + "…"


def cmd_add(c, args):
    if not args:
        die("usage: q add <agent> [text | -]")
    agent, rest = args[0], args[1:]
    known = herdr_agents()
    if known and agent not in known:
        die(f"agent '{agent}' is not running in herdr (running: {', '.join(sorted(known))})")
    cur = c.execute("INSERT INTO tasks(agent, prompt) VALUES (?,?)", (agent, text_arg(rest)))
    c.commit()
    print(f"#{cur.lastrowid} queued for {agent}")
    tick(c)


def cmd_answer(c, args, status):
    if not args:
        die(f"usage: q {'answer' if status == 'answered' else 'fail'} <id> [text | -]")
    tid = int(args[0].lstrip("#"))
    r = get(c, tid)
    if r["status"] not in OPEN + DONE:
        die(f"#{tid} is already '{r['status']}'; nothing stored")
    c.execute("UPDATE tasks SET status=?, response=?, answered_at=datetime('now','localtime') WHERE id=?",
              (status, text_arg(args[1:]), tid))
    c.commit()
    print(f"stored #{tid} ({status}{', replacing the previous answer' if r['status'] in DONE else ''})")
    tick(c, quiet=True)  # frees the next task of the same agent


def cmd_list(c, args):
    if "--all" in args:
        rows = c.execute("SELECT * FROM tasks ORDER BY id").fetchall()
    elif "--status" in args:
        s = args[args.index("--status") + 1]
        rows = c.execute("SELECT * FROM tasks WHERE status=? ORDER BY id", (s,)).fetchall()
    else:
        rows = c.execute("SELECT * FROM tasks WHERE status NOT IN ('validated','cancelled') ORDER BY id").fetchall()
    agents = herdr_agents() if any(r["status"] == "sent" for r in rows) else {}
    for r in rows:
        extra = f" (herdr: {agents.get(r['agent'], '?')})" if r["status"] == "sent" else ""
        print(f"#{r['id']:<4} {r['status']:<10} {r['agent']:<16} {r['created_at'][5:16]}  {short(r['prompt'])}{extra}")
    if not rows:
        print("(no tasks)")


def cmd_show(c, args):
    r = get(c, int(args[0].lstrip("#")))
    print(f"#{r['id']} {r['agent']} [{r['status']}]  created {r['created_at']}  sent {r['sent_at'] or '-'}  "
          f"answered {r['answered_at'] or '-'}  validated {r['validated_at'] or '-'}"
          + (f"  (retry of #{r['parent_id']})" if r["parent_id"] else ""))
    print("\n--- prompt\n" + r["prompt"])
    print("\n--- answer\n" + (r["response"] or "(no answer)"))
    if r["notes"]:
        print("\n--- validation\n" + r["notes"])


def cmd_validate(c, args, status):
    if not args:
        die("usage: q validate|reject <id> [note]")
    retry = "--retry" in args
    args = [a for a in args if a != "--retry"]
    tid = int(args[0].lstrip("#"))
    r = get(c, tid)
    if r["status"] not in DONE:
        die(f"#{tid} is '{r['status']}'; only answered tasks can be validated/rejected")
    note = " ".join(args[1:]) or None
    c.execute("UPDATE tasks SET status=?, notes=?, validated_at=datetime('now','localtime') WHERE id=?",
              (status, note, tid))
    c.commit()
    print(f"#{tid} {status}")
    if status == "rejected" and retry:
        prompt = r["prompt"] + f"\n\n[Redoing task #{tid}, which was rejected]" + (f"\nReason: {note}" if note else "")
        cur = c.execute("INSERT INTO tasks(agent, prompt, parent_id) VALUES (?,?,?)", (r["agent"], prompt, tid))
        c.commit()
        print(f"#{cur.lastrowid} re-queued for {r['agent']}")
        tick(c)


def cmd_cancel(c, args):
    tid = int(args[0].lstrip("#"))
    r = get(c, tid)
    if r["status"] not in OPEN:
        die(f"#{tid} is already '{r['status']}'")
    c.execute("UPDATE tasks SET status='cancelled', validated_at=datetime('now','localtime') WHERE id=?", (tid,))
    c.commit()
    print(f"#{tid} cancelled" + (" (it had already been sent: the agent may keep working on it)" if r["status"] == "sent" else ""))
    tick(c, quiet=True)


def cmd_wait(c, args):
    timeout = 1800
    if "--timeout" in args:
        i = args.index("--timeout")
        timeout = int(args[i + 1])
        args = args[:i] + args[i + 2:]
    ids = [int(a.lstrip("#")) for a in args] or [r["id"] for r in c.execute(
        "SELECT id FROM tasks WHERE status IN ('pending','sent')")]
    if not ids:
        print("(nothing open)")
        return
    start, idle_since = time.time(), {}
    while True:
        tick(c, quiet=True)
        rows = {r["id"]: r for r in c.execute(
            f"SELECT * FROM tasks WHERE id IN ({','.join('?' * len(ids))})", ids)}
        open_ = [i for i in ids if rows[i]["status"] in OPEN]
        # the agent became free again with the task sent and no answer stored: it probably forgot `q answer`
        agents = herdr_agents() if open_ else {}
        stale = []
        for i in open_:
            r = rows[i]
            if r["status"] == "sent" and agents.get(r["agent"]) in FREE:
                idle_since.setdefault(i, time.time())
                if time.time() - idle_since[i] > 90:
                    stale.append(i)
            else:
                idle_since.pop(i, None)
            if agents.get(r["agent"]) == "blocked":
                stale.append(i)
        if not open_:
            # wait for the agent to finish its turn: it may fix the answer right after storing it
            busy = herdr_agents()
            if all(busy.get(rows[i]["agent"]) != "working" for i in ids) or time.time() - start > timeout:
                rows = {r["id"]: r for r in c.execute(
                    f"SELECT * FROM tasks WHERE id IN ({','.join('?' * len(ids))})", ids)}
                break
        elif set(open_) <= set(stale) or time.time() - start > timeout:
            break
        time.sleep(5)
    for i in ids:
        r = rows[i]
        flag = ""
        if i in stale:
            st = agents.get(r["agent"])
            flag = "  <- agent BLOCKED (waiting for approval?)" if st == "blocked" else "  <- agent free without storing an answer"
        print(f"#{i:<4} {r['status']:<10} {r['agent']:<16} {short(r['response'] or r['prompt'])}{flag}")
    if open_ and not set(open_) <= set(stale):
        print(f"q: timeout ({timeout}s) with open tasks", file=sys.stderr)
        sys.exit(2)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    c = db()
    if cmd == "add":
        cmd_add(c, args)
    elif cmd == "answer":
        cmd_answer(c, args, "answered")
    elif cmd == "fail":
        cmd_answer(c, args, "failed")
    elif cmd == "tick":
        tick(c) or print("(nothing to send)")
    elif cmd == "list":
        cmd_list(c, args)
    elif cmd == "show":
        cmd_show(c, args)
    elif cmd == "validate":
        cmd_validate(c, args, "validated")
    elif cmd == "reject":
        cmd_validate(c, args, "rejected")
    elif cmd == "cancel":
        cmd_cancel(c, args)
    elif cmd == "wait":
        cmd_wait(c, args)
    else:
        die(f"unknown command: {cmd} (see q --help)", 2)


if __name__ == "__main__":
    main()
