#!/usr/bin/env python3
"""q — fila de tarefas entre o orquestrador e os agentes do herdr (SQLite local).

Orquestrador:
  q add <agente> [texto | -]        enfileira (texto via argumento ou stdin com "-") e já tenta despachar
  q tick                            despacha a próxima tarefa de cada agente livre (idle/done no herdr)
  q wait [id ...] [--timeout S]     espera as tarefas (default: todas em aberto) serem respondidas
  q list [--all | --status S]       lista tarefas (default: as que não foram validadas/canceladas)
  q show <id>                       mostra prompt, resposta e validação
  q validate <id> [nota]            aceita a resposta
  q reject <id> [nota] [--retry]    rejeita; com --retry reenfileira o prompt + a nota para o mesmo agente
  q cancel <id>                     cancela uma tarefa ainda não respondida

Agentes:
  q answer <id> [texto | -]         grava o retorno final (stdin quando "-" ou sem texto);
                                    pode ser repetido para corrigir enquanto a tarefa não foi validada
  q fail <id> [texto | -]           grava que não conseguiu concluir e por quê

Banco: $Q_DB (o shim gerado pelo herdr-db-setup em <raiz>/.herdr-db/q já define) ou ~/.local/share/herdr-db/queue.db.
Estados: pending -> sent -> answered|failed -> validated|rejected (ou cancelled).
"""
import json
import os
import re
import sqlite3
import subprocess
import sys
import time

DB = os.path.expanduser(os.environ.get("Q_DB") or "~/.local/share/herdr-db/queue.db")
# caminho que os agentes devem chamar: o shim do workspace (define Q_DB) ou este próprio arquivo
Q = os.environ.get("Q_SELF") or os.path.realpath(__file__)
OPEN = ("pending", "sent")
DONE = ("answered", "failed")
FREE = ("idle", "done")

SCHEMA = """
CREATE TABLE IF NOT EXISTS tasks (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  agent        TEXT NOT NULL,
  prompt       TEXT NOT NULL,
  status       TEXT NOT NULL DEFAULT 'pending'
               CHECK (status IN ('pending','sent','answered','failed','validated','rejected','cancelled')),
  response     TEXT,
  notes        TEXT,
  parent_id    INTEGER REFERENCES tasks(id),
  created_at   TEXT NOT NULL DEFAULT (datetime('now','localtime')),
  sent_at      TEXT,
  answered_at  TEXT,
  validated_at TEXT
);
CREATE INDEX IF NOT EXISTS tasks_agent_status ON tasks(agent, status);
"""

ENVELOPE = """[tarefa #{id} da fila do orquestrador]

{prompt}

---
Ao terminar, grave seu retorno final na fila (é só por ali que o orquestrador recebe a resposta).
Rode exatamente assim, com o texto direto dentro do heredoc (não use variáveis como $RESPOSTA):
{q} answer {id} <<'FIM_Q'
<retorno completo, no formato pedido>
FIM_Q
Se não conseguir concluir (bloqueio, erro, falta de permissão ou de informação), use `{q} fail {id}` do mesmo jeito.
Se gravou algo errado, rode `answer` de novo: ele substitui a resposta enquanto a tarefa não foi validada.
NUNCA edite, recrie ou redirecione saída para {q} nem mexa em {db} diretamente (sqlite3/python). Se o comando falhar, cole o erro no chat e pare.
Depois de gravar, responda no chat apenas: registrado #{id}"""


def db():
    os.makedirs(os.path.dirname(DB), exist_ok=True)
    c = sqlite3.connect(DB, timeout=30)
    c.row_factory = sqlite3.Row
    c.execute("PRAGMA journal_mode=WAL")
    c.execute("PRAGMA busy_timeout=30000")
    c.executescript(SCHEMA)
    return c


def die(msg, code=1):
    print(f"q: {msg}", file=sys.stderr)
    sys.exit(code)


def text_arg(args):
    if not args or args == ["-"]:
        data = sys.stdin.read()
    else:
        data = " ".join(args)
    data = data.strip("\n")
    if not data.strip():
        die("texto vazio")
    if re.fullmatch(r"\s*\$\{?\w+\}?\s*", data):
        die(f"o texto é só '{data.strip()}': variável não expandida. Coloque o retorno direto no heredoc.")
    return data


def get(c, tid):
    r = c.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()
    if not r:
        die(f"tarefa #{tid} não existe")
    return r


def herdr_agents():
    """nome -> status do agente no herdr (vazio se o herdr não responder)."""
    try:
        out = subprocess.run(["herdr", "agent", "list"], capture_output=True, text=True, timeout=15).stdout
        return {a.get("name"): a["agent_status"] for a in json.loads(out)["result"]["agents"] if a.get("name")}
    except Exception:
        return {}


def tick(c, quiet=False):
    """Despacha a tarefa pendente mais antiga de cada agente livre e sem tarefa em andamento."""
    agents = herdr_agents()
    sent = []
    busy = {r["agent"] for r in c.execute("SELECT DISTINCT agent FROM tasks WHERE status='sent'")}
    for r in c.execute("SELECT * FROM tasks WHERE status='pending' ORDER BY id").fetchall():
        a = r["agent"]
        if a in busy or agents.get(a) not in FREE:
            continue
        msg = ENVELOPE.format(id=r["id"], prompt=r["prompt"], q=Q, db=DB)
        p = subprocess.run(["herdr", "agent", "prompt", a, msg], capture_output=True, text=True)
        if p.returncode != 0:
            print(f"q: falha ao enviar #{r['id']} para {a}: {p.stderr.strip() or p.stdout.strip()}", file=sys.stderr)
            continue
        c.execute("UPDATE tasks SET status='sent', sent_at=datetime('now','localtime') WHERE id=?", (r["id"],))
        c.commit()
        busy.add(a)
        sent.append(r["id"])
        if not quiet:
            print(f"enviada #{r['id']} -> {a}")
    return sent


def short(s, n=70):
    s = " ".join((s or "").split())
    return s if len(s) <= n else s[: n - 1] + "…"


def cmd_add(c, args):
    if not args:
        die("uso: q add <agente> [texto | -]")
    agent, rest = args[0], args[1:]
    known = herdr_agents()
    if known and agent not in known:
        die(f"agente '{agent}' não está rodando no herdr (rodando: {', '.join(sorted(known))})")
    cur = c.execute("INSERT INTO tasks(agent, prompt) VALUES (?,?)", (agent, text_arg(rest)))
    c.commit()
    print(f"#{cur.lastrowid} enfileirada para {agent}")
    tick(c)


def cmd_answer(c, args, status):
    if not args:
        die(f"uso: q {'answer' if status == 'answered' else 'fail'} <id> [texto | -]")
    tid = int(args[0].lstrip("#"))
    r = get(c, tid)
    if r["status"] not in OPEN + DONE:
        die(f"#{tid} já está '{r['status']}'; nada gravado")
    c.execute("UPDATE tasks SET status=?, response=?, answered_at=datetime('now','localtime') WHERE id=?",
              (status, text_arg(args[1:]), tid))
    c.commit()
    print(f"registrado #{tid} ({status}{', substituindo a resposta anterior' if r['status'] in DONE else ''})")
    tick(c, quiet=True)  # libera a próxima tarefa do mesmo agente


def cmd_list(c, args):
    if "--all" in args:
        rows = c.execute("SELECT * FROM tasks ORDER BY id").fetchall()
    elif "--status" in args:
        s = args[args.index("--status") + 1]
        rows = c.execute("SELECT * FROM tasks WHERE status=? ORDER BY id", (s,)).fetchall()
    else:
        rows = c.execute("SELECT * FROM tasks WHERE status NOT IN ('validated','cancelled') ORDER BY id").fetchall()
    agents = herdr_agents() if any(r["status"] == "sent" for r in rows) else {}
    for r in rows:
        extra = f" (herdr: {agents.get(r['agent'], '?')})" if r["status"] == "sent" else ""
        print(f"#{r['id']:<4} {r['status']:<10} {r['agent']:<16} {r['created_at'][5:16]}  {short(r['prompt'])}{extra}")
    if not rows:
        print("(nenhuma tarefa)")


def cmd_show(c, args):
    r = get(c, int(args[0].lstrip("#")))
    print(f"#{r['id']} {r['agent']} [{r['status']}]  criada {r['created_at']}  enviada {r['sent_at'] or '-'}  "
          f"respondida {r['answered_at'] or '-'}  validada {r['validated_at'] or '-'}"
          + (f"  (retry de #{r['parent_id']})" if r["parent_id"] else ""))
    print("\n--- prompt\n" + r["prompt"])
    print("\n--- resposta\n" + (r["response"] or "(sem resposta)"))
    if r["notes"]:
        print("\n--- validação\n" + r["notes"])


def cmd_validate(c, args, status):
    if not args:
        die("uso: q validate|reject <id> [nota]")
    retry = "--retry" in args
    args = [a for a in args if a != "--retry"]
    tid = int(args[0].lstrip("#"))
    r = get(c, tid)
    if r["status"] not in DONE:
        die(f"#{tid} está '{r['status']}'; só dá para validar/rejeitar tarefas respondidas")
    note = " ".join(args[1:]) or None
    c.execute("UPDATE tasks SET status=?, notes=?, validated_at=datetime('now','localtime') WHERE id=?",
              (status, note, tid))
    c.commit()
    print(f"#{tid} {status}")
    if status == "rejected" and retry:
        prompt = r["prompt"] + f"\n\n[Refazendo a tarefa #{tid}, que foi rejeitada]" + (f"\nMotivo: {note}" if note else "")
        cur = c.execute("INSERT INTO tasks(agent, prompt, parent_id) VALUES (?,?,?)", (r["agent"], prompt, tid))
        c.commit()
        print(f"#{cur.lastrowid} reenfileirada para {r['agent']}")
        tick(c)


def cmd_cancel(c, args):
    tid = int(args[0].lstrip("#"))
    r = get(c, tid)
    if r["status"] not in OPEN:
        die(f"#{tid} já está '{r['status']}'")
    c.execute("UPDATE tasks SET status='cancelled', validated_at=datetime('now','localtime') WHERE id=?", (tid,))
    c.commit()
    print(f"#{tid} cancelada" + (" (já tinha sido enviada: o agente pode continuar trabalhando nela)" if r["status"] == "sent" else ""))
    tick(c, quiet=True)


def cmd_wait(c, args):
    timeout = 1800
    if "--timeout" in args:
        i = args.index("--timeout")
        timeout = int(args[i + 1])
        args = args[:i] + args[i + 2:]
    ids = [int(a.lstrip("#")) for a in args] or [r["id"] for r in c.execute(
        "SELECT id FROM tasks WHERE status IN ('pending','sent')")]
    if not ids:
        print("(nada em aberto)")
        return
    start, idle_since = time.time(), {}
    while True:
        tick(c, quiet=True)
        rows = {r["id"]: r for r in c.execute(
            f"SELECT * FROM tasks WHERE id IN ({','.join('?' * len(ids))})", ids)}
        open_ = [i for i in ids if rows[i]["status"] in OPEN]
        # agente voltou a ficar livre com a tarefa enviada e sem gravar resposta: provavelmente esqueceu do q answer
        agents = herdr_agents() if open_ else {}
        stale = []
        for i in open_:
            r = rows[i]
            if r["status"] == "sent" and agents.get(r["agent"]) in FREE:
                idle_since.setdefault(i, time.time())
                if time.time() - idle_since[i] > 90:
                    stale.append(i)
            else:
                idle_since.pop(i, None)
            if agents.get(r["agent"]) == "blocked":
                stale.append(i)
        if not open_:
            # espera o agente terminar o turno: ele pode corrigir a resposta logo depois de gravá-la
            busy = herdr_agents()
            if all(busy.get(rows[i]["agent"]) != "working" for i in ids) or time.time() - start > timeout:
                rows = {r["id"]: r for r in c.execute(
                    f"SELECT * FROM tasks WHERE id IN ({','.join('?' * len(ids))})", ids)}
                break
        elif set(open_) <= set(stale) or time.time() - start > timeout:
            break
        time.sleep(5)
    for i in ids:
        r = rows[i]
        flag = ""
        if i in stale:
            st = agents.get(r["agent"])
            flag = "  <- agente BLOQUEADO (pedindo aprovação?)" if st == "blocked" else "  <- agente livre sem ter gravado resposta"
        print(f"#{i:<4} {r['status']:<10} {r['agent']:<16} {short(r['response'] or r['prompt'])}{flag}")
    if open_ and not set(open_) <= set(stale):
        print(f"q: timeout ({timeout}s) com tarefas em aberto", file=sys.stderr)
        sys.exit(2)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = sys.argv[1], sys.argv[2:]
    c = db()
    if cmd == "add":
        cmd_add(c, args)
    elif cmd == "answer":
        cmd_answer(c, args, "answered")
    elif cmd == "fail":
        cmd_answer(c, args, "failed")
    elif cmd == "tick":
        tick(c) or print("(nada para enviar)")
    elif cmd == "list":
        cmd_list(c, args)
    elif cmd == "show":
        cmd_show(c, args)
    elif cmd == "validate":
        cmd_validate(c, args, "validated")
    elif cmd == "reject":
        cmd_validate(c, args, "rejected")
    elif cmd == "cancel":
        cmd_cancel(c, args)
    elif cmd == "wait":
        cmd_wait(c, args)
    else:
        die(f"comando desconhecido: {cmd} (veja q --help)", 2)


if __name__ == "__main__":
    main()
